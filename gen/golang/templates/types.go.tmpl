{{define "types"}}

{{if .Messages}}
//
// Types
//

{{range .Messages}}
  {{if .Type | isEnum}}
    {{$enumName := .Name}}
    {{$enumType := .EnumType}}
    type {{$enumName}} {{$enumType}}

    const (
      {{- range .Fields}}
        {{$enumName}}_{{.Name}} {{$enumName}} = {{.Value}}
      {{- end}}
    )

    var {{$enumName}}_name = map[{{$enumType}}]string {
      {{- range .Fields}}
        {{.Value}}: "{{.Name}}",
      {{- end}}
    }

    var {{$enumName}}_value = map[string]{{$enumType}} {
      {{- range .Fields}}
        "{{.Name}}": {{.Value}},
      {{- end}}
    }

    func (x {{$enumName}}) String() string {
      return {{$enumName}}_name[{{$enumType}}(x)]
    }

    func (x {{$enumName}}) MarshalJSON() ([]byte, error) {
      []byte(fmt.Sprint(int64(x))), nil
    }

    func (x *{{$enumName}}) UnmarshalJSON(b []byte) error {
      var j string
      err := json.Unmarshal(b, &j)
      if err != nil {
        return err
      }

      k, err := strconv.ParseInt(j, 10, 64)

      if err != nil {
        return err
      }

      if {{$enumName}}_name[k] == "" {
        return errors.New("unkown value for enum: {{$enumName}}")
      }

      *x = {{$enumName}}(k)
      return nil
    }

  {{end}}
  {{if .Type | isStruct  }}
    type {{.Name}} struct {
      {{- range .Fields}}
        {{. | exportedField}} {{. | fieldOptional}}{{. | fieldTypeDef}} {{. | fieldTags}}
      {{- end}}
    }

    {{ if . | structHasValidation }}
    func (t {{.Name}}) Validate() error {
        return validation.ValidateStruct(
        &t,
        {{- range .Fields}}
          {{- if . | fieldHasValidation }}
            validation.Field(&t.{{. | exportedField}}, {{ . | validators }}),
          {{ end }}
        {{- end}}
      )
    }
    {{end}}
  {{end}}
{{end}}
{{end}}
{{if .Services}}
  {{range .Services}}
    type {{.Name}} interface {
      {{- range .Methods}}
        {{.Name}}({{.Inputs | methodInputs}}) ({{.Outputs | methodOutputs}})
      {{- end}}
    }
  {{end}}
  var WebRPCServices = map[string][]string{
    {{- range .Services}}
      "{{.Name}}": {
        {{- range .Methods}}
          "{{.Name}}",
        {{- end}}
      },
    {{- end}}
  }
{{end}}

{{end}}
